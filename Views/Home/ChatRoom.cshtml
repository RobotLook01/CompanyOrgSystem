function showForm() {
    const box = document.getElementById('inputFormBox');
    box.style.display = 'block';
    if (simplemde) simplemde.codemirror.refresh();
    box.scrollIntoView({ behavior: 'smooth' });
}

// ★親子判別＋変更・削除ボタンが並ぶ再帰レンダリング関数！
function renderTree(messages, container, level, currentGroupDiv) {
    messages.forEach(msg => {
        const postDiv = document.createElement('div');

        // ⭕ 【ここを追加！】届いた日時文字列を、日本人に馴染みのある「年/月/日 時:分」の形に美しく整形します！
        const formattedDate = msg.createdAt ? new Date(msg.createdAt).toLocaleString('ja-JP', { year: 'numeric', month: '2-digit', day: '2-digit', hour: '2-digit', minute: '2-digit' }) : '本日';

        // JavaScriptの文字列のクォーテーションエラーを防ぐための安全なエスケープ処理
        const safeText = msg.contentMarkdown.replace(/\\/g, '\\\\').replace(/`/g, '\\`').replace(/'/g, "\\'");

        // ★ボタン配置エリアのHTML組み立て
        const actionButtons = `
        <div class="d-flex justify-content-between align-items-center mt-2">
        <div>
        <!-- ✏️変更ボタン と 🗑️削除ボタン を配置！ -->
        <button class="btn-edit-trigger" onclick="openEditForm(${msg.messageId}, \`${safeText}\`)">✏️ 変更</button>
        <button class="btn-delete-trigger" onclick="openDeleteForm(${msg.messageId}, \`${safeText}\`)">🗑️ 削除</button>
        </div>
        <button class="btn-comment-trigger" onclick="openCommentForm(${msg.messageId})">💬 コメントを追記</button>
        </div>
        `;

        if (level === 0) {
            const threadGroup = document.createElement('div');
            threadGroup.classList.add('wiki-thread-group');
            container.appendChild(threadGroup);

            postDiv.classList.add('parent-post');
            postDiv.innerHTML = `
                <div class="d-flex justify-content-between align-items-center mb-2">
                <span class="badge-thread">📌 メインスレッド (ID: ${msg.messageId})</span>

                <!-- ⭕ 整形した日付変数（formattedDate）を表示させます！ -->
                <!-- span style="font-size: 11px; color: #7f8c8d;">📅 ${msg.createdAt || '本日'}</span -->
                <!-- span style="font-size: 11px; color: #7f8c8d; font-weight: bold;">📅 登録: ${formattedDate}</span -->
                <span style="font-size: 11px; color: #7f8c8d; font-weight: bold;">📅(ID: ${msg.messageId}): ${formattedDate}</span>

                </div>
                <div style="font-size: 16px; color: #2c3e50; font-weight: 500; line-height: 1.6;">${msg.contentMarkdown}</div>
                ${actionButtons}
            `;
            threadGroup.appendChild(postDiv);
            currentGroupDiv = threadGroup;
        } else {
            postDiv.classList.add('reply-post');
            if (level === 1) postDiv.classList.add('reply-level-1');
            if (level >= 2) postDiv.classList.add('reply-level-2');

            postDiv.innerHTML = `
                <div class="d-flex justify-content-between align-items-center mb-1">


                <!-- span class="badge-comment">💬 コメント返信 (ID: ${msg.messageId})</span -->
                <!-- 📅 ${msg.createdAt || '本日'} -->

                <!-- ⭕ コメント側にも整形した日付変数（formattedDate）を表示させます！ -->
                <!-- span style="font-size: 11px; color: #95a5a6; font-weight: bold;">📅 登録: ${formattedDate}</span -->
                <span style="font-size: 11px; color: #95a5a6; font-weight: bold;">📅 (ID: ${msg.messageId}): ${formattedDate}</span>

                ${msg.contentMarkdown}
                ${actionButtons}
            `;
            currentGroupDiv.appendChild(postDiv);
        }
        if (msg.replies && msg.replies.length > 0) {
            renderTree(msg.replies, container, level + 1, currentGroupDiv);
        }
    });
}

// ★モード（新規・変更・削除）に応じて、裏側のC#窓口を動的に切り替えるメインロジック！
function sendChatJson() {
    const pass = document.getElementById('adminPass').value;
    const pId = document.getElementById('parentId').value;
    const mId = document.getElementById('editMessageId').value;
    const markdown = simplemde.value();
    const jsonPayload = {
        adminPassword: pass,
        messageId: mId ? parseInt(mId) : null,
        parentId: pId ? parseInt(pId) : null,
        senderName: "本人投稿",
        contentMarkdown: markdown
    };
    // モードフラグによって、通信するC#のURLをカチッと切り替えます！
    let targetUrl = "/api/chat/sendWithFile"; // デフォルト（新規）
    if (currentMode === "update") targetUrl = "/api/chat/updateMessage";
    if (currentMode === "delete") targetUrl = "/api/chat/deleteMessage";
    fetch(targetUrl, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(jsonPayload)
    })
    .then(res => res.json())
    .then(data => {
        if (data.success) {
            simplemde.value('');
            document.getElementById('adminPass').value = '';
            document.getElementById('parentId').value = '';
            document.getElementById('editMessageId').value = '';
            document.getElementById('inputFormBox').style.display = 'none';
            fetchTimeline(); // タイムラインを瞬間リロード！
        }
    })
    .catch(err => alert("通信エラー、または合言葉が違います。"));
    fetchTimeline(); // タイムラインを瞬間リロード！
}
</script>