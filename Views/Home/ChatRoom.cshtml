function fetchTimeline() {
    fetch('/api/chat/messages')
    .then(res => res.json())
    .then(data => {
    const container = document.getElementById('wikiTimeline');
    container.innerHTML = '';
    renderTree(data, container, 0, null);
    })
    .catch(err => console.error("データ取得失敗:", err));
}

