@{
    ViewData["Title"] = "開発プラン研究Wiki";
}
<script>
    // 💡 対策1：本番環境のURLズレをC#側で自動解決する
    // 固定文字列ではなく、C#の機能を使って本番環境の正しいメニューURLを自動生成させます
    var menuUrl = '@Url.Action("Index", "Home")';
    
    // 生成された正しいURLで履歴を上書きします
    history.replaceState(null, '', menuUrl);

    // 💡 対策2：本番サーバー特有の強力なキャッシュ戻りを強制リセットする
    window.addEventListener('pageshow', function (event) {
        // もしブラウザがJavaScriptを無視してキャッシュから無理やり管理者画面を表示させたら、
        // 即座に検知してメニュー画面へ強制リダイレクト（上書き遷移）させます
        if (event.persisted || (window.performance && window.performance.navigation.type === 2)) {
            window.location.replace(menuUrl);
        }
    });
</script>
