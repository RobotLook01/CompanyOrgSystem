function openEditForm(messageId, currentText) {
    // 1. 💡 まず最初に「確認ダイアログ」を表示します
    const confirmationMessage =
        "【✏ 投稿 [ID:" + messageId + "] 変更確認】\n\n" +
        "選択された投稿を本当に変更しますか。\n"; 

    // 2. 💡 ユーザーが「キャンセル」を押したら、何もせずにここで完全にリターン（終了）します
    if (!window.confirm(confirmationMessage)) {
        showForm();
        return; // ❌ 画面の状態を変えずに、何もしないで処理を抜けます
    }

    // 3. ⭕ ユーザーが「OK（削除する）」を押した場合のみ、以下のフォームを開く処理に進みます
    currentMode = "update";

    // ポートフォリオとして洗練された表現にタイトルを整えます
        document.getElementById('formTitle').innerText = `✏ 投稿 [ID: ${messageId}] の変更（関連データ連動変更）`;

    document.getElementById('parentId').value = "";
    document.getElementById('editMessageId').value = messageId;

    // ボタンのスタイルとテキストをスマートに切り替え（長文は入れず、すっきりさせます）
    document.getElementById('btnSubmitForm').className = "btn btn-danger w-100 fw-bold mt-2";
    document.getElementById('btnSubmitForm').innerText = "変更を確定する";

    // 4. エディタに元の文章を復元し、最上部に合言葉の案内をスマートに添えます
    if (simplemde) simplemde.value(currentText);
    showForm();
}


