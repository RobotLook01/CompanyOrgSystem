@model IEnumerable<CompanyOrgSystem.Models.EmployeeSearchResult>
@{
    bool isAdmin = ViewBag.IsAdmin ?? false;
    //bool isKeyword = ViewBag.Keyword != null && !string.IsNullOrEmpty(ViewBag.Keyword.ToString());
    ViewData["Title"] = isAdmin ? "【管理者】社員検索" : "【一般】社員検索";
}

<!-- 💡 ここから追加（ローカルでも本番でも100%動く超シンプル版） -->
<script>
    (function () {
        // C#の機能を使って、どこにいても正しいメニュー画面のURL（/Home/Index など）を自動計算する
        var menuUrl = '@Url.Action("Index", "Home")';

        // 1. 画面が表示される瞬間に、履歴を「管理者画面」から「メニュー画面」にすり替える
        history.replaceState(null, '', menuUrl);

        // 2. 【超重要】もし「戻るボタン」でこのURL（管理者画面）に再進入してきたら
        window.addEventListener('pageshow', function (event) {
            // キャッシュからの復元、または戻る移動（type === 2）を検知した場合
            if (event.persisted || (window.performance && window.performance.navigation.type === 2)) {
                // ユーザーが何かを見る前に、最速でメニュー画面へ追い出す
                window.location.replace(menuUrl);
            }
        });
    })();
</script>
<!-- 💡 ここまで追加 -->
<!-- この下は、あなたの元の綺麗なBootstrapのHTML（div等）をそのまま続けてください -->

<!-- 💡 対策1: 画面全体（htmlごと）を、読み込まれた瞬間に最速で「真っ白（非表示）」にする -->
<!--style id="security-shield">
    html, body { display: none !important; visibility: hidden !important; opacity: 0 !important; }
</style-->

<!-- ここから下に、あなたの元の綺麗なBootstrapのHTML（div等）をそのまま続けてください -->

<div class="container mt-4">
    <!-- 権限によってヘッダーの色と文字を変える -->
    <div class="p-4 mb-4 rounded-3 shadow-sm @(isAdmin ? "bg-danger text-white" : "bg-light text-dark")">
    <!--div id="admin-main-card" class="card text-white" style="background-color: transparent; transition: background-color 0.1s;"-->
    <!--div id="admin-main-card" class="card text-white" style="background-color: transparent; transition: background-color 0.1s;"-->
        <h2 class="fw-bold">
            @(isAdmin ? "🔒 人事管理システム [管理者専用モード]デモ画面" : "👤 人事管理システム [一般ユーザーモード]")
        </h2>
        <p class="m-0 fs-6">
            @(isAdmin ? "すべての社員の所属・兼務情報、および管理者用権限での閲覧が可能です。" : "社員名から所属している組織の一覧を検索できます。")
        </p>
    </div>
    <!-- 🔍 検索フォーム -->
    <form asp-controller="Home" asp-action="DoSearch" method="post" class="row g-3 my-4 bg-white p-3 border rounded shadow-sm">
        <input type="hidden" name="isAdmin" value="@isAdmin.ToString().ToLower()" />
        <div class="col-md-8">
            <!--input type="text" name="keyword" class="form-control form-control-lg" placeholder="社員名を入力（例：鈴木）" required /-->
            <!-- ⭕ 修正後：required を完全に削除する -->
            <!--input type="text" name="keyword" class="form-control form-control-lg" placeholder="社員名を入力（例：鈴木）" /-->
            <!--「もしnullなら空文字（""）にする」という安全な構文（ヌル合体演算子 ??）に書き換え-->
            <input type="text" name="keyword" value="@(ViewBag.Keyword ?? "")" class="form-control form-control-lg" placeholder="社員名を入力（例：鈴木）" />
        </div>
        <div class="col-md-4 d-flex align-items-end">
            <button type="submit" class="btn @(isAdmin ? "btn-danger" : "btn-primary") btn-lg w-100 fw-bold shadow">
                🔎 検索実行
            </button>
        </div>
    </form>
    <!-- 💡 追加ポイント：管理者専用の組織図ツリー確認リンクボタン -->
    @if (isAdmin)
    {
        <div class="my-3 p-3 bg-danger bg-opacity-10 border border-danger rounded text-end shadow-sm">
            <span class="fw-bold text-danger me-3">【管理者限定機能】全組織のつながりを階層構造で確認できます：</span>
            <a asp-controller="Home" asp-action="OrgTree" class="btn btn-danger fw-bold shadow-sm">
                🌳 組織図ツリー表示画面を開く
            </a>
        </div>
    }
    <div class="d-flex justify-content-between align-items-center mt-4">
        <h4 class="fw-bold text-secondary">📋 検索結果一覧</h4>
        <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary fw-bold">◀ メニューに戻る</a>
    </div>

    <!-- 📊 グリッド（表） -->
    <div class="table-responsive mt-3 shadow-sm rounded">
        <table class="table table-striped table-hover table-bordered align-middle m-0">
            <thead class="@(isAdmin ? "table-danger border-danger" : "table-dark") text-center">
                <tr>
                    <th>社員ID</th>
                    <th>社員名</th>
                    <th>所属組織</th>
                    <th>区分</th>
                    <th>メールアドレス</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="text-center font-monospace">@item.EmployeeId</td>
                            <td><strong class="text-primary fs-5">@item.EmployeeName</strong></td>
                            <td>@item.DepartmentName</td>
                            <td class="text-center">
                                @if (item.DivisionType == "主務")
                                {
                                    <span class="badge bg-success px-3 py-2 fs-6">@item.DivisionType</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning text-dark px-3 py-2 fs-6">@item.DivisionType</span>
                                }
                            </td>
                            <td>✉️ @item.Email</td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="5" class="text-center text-muted py-5 bg-white">
                            💡 該当するデータがありません。
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>