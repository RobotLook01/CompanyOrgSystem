@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    ViewData["Title"] = "製品詳細・バージョン履歴";
    var productId = Context.Request.Query["id"].ToString();
}

<div class="container mt-4">
    <div class="mb-3">
        <a href="/Product/Index?secret=@Context.Request.Query["secret"]" class="btn btn-sm btn-outline-secondary fw-bold shadow-sm">
            ◀ 製品一覧に戻る
        </a>
    </div>

    <!-- 1. ヘッダーエリア -->
    <div class="card bg-light mb-4 shadow-sm">
        <div class="card-body d-flex justify-content-between align-items-center flex-wrap">
            <div>
                <span class="text-muted small">製品ID: <code>@productId</code></span>
                <h3 class="fw-bold text-dark mb-0" id="txtProductName">プログラム詳細仕様</h3>
            </div>
            <div class="d-flex align-items-center mt-2 mt-md-0">
                <label class="fw-bold me-2 text-nowrap" for="versionDropdown">Ver切り替え:</label>
                <!-- ★ 手書きの選択肢（option）をすべて削除し、完全に空っぽ（動的配置用）にします -->
                <select id="versionDropdown" class="form-select" onchange="loadVersionData()">
                </select>
            </div>
        </div>
    </div>

    <div class="row">
        <!-- 2. 左側：画面ハードコピー（スクショ）表示エリア -->
        @*<div id="imageArea" class="col-md-5 text-center" style="display: none;">
            <h5 class="fw-bold text-secondary mb-2">📷 動作画面（スクショ）</h5>
            <div class="p-2 border rounded bg-white shadow-sm">
                <!--img id="productImage" src="" alt="動作画面ハードコピー" class="img-fluid" style="max-height: 420px;" 
                     onload="toggleImageArea(true)" onerror="toggleImageArea(false)" /-->
                <!-- srcに透明な1マスの画像を初期値として入れておくことで、スマホの先走りエラーを完全に防ぎます -->
                <img id="productImage" src="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7"
                     alt="動作画面ハードコピー" class="img-fluid" style="max-height: 420px;"
                     onload="toggleImageArea(true)" onerror="toggleImageArea(false)" />
            </div>
        </div> *@
        <!-- 📄 2. 左側：画面ハードコピー（スクショ）表示エリア -->
        <!-- 💡 初期状態は display: none; のままでOKです -->
        <div id="imageArea" class="col-md-5 text-center" style="display: none;">
            <h5 class="fw-bold text-secondary mb-2">📷 動作画面（スクショ）</h5>
            <div class="p-2 border rounded bg-white shadow-sm">
                <!-- ❌ onerror と onload をここから完全に撤去します！ -->
                <!-- 💡 代わりに、画像が届く直前のチラつきを防ぐため、最初は不透明度0（見えない状態）にしておきます -->
                <img id="productImage" src="" alt="動作画面ハードコピー" class="img-fluid" style="max-height: 420px; opacity: 0; transition: opacity 0.2s;" />
            </div>
        </div>

        <!-- 3. 右側：可変明細（技術スタック・更新履歴）表示エリア -->
        <div id="detailArea" class="col-md-12">
            <h5 class="fw-bold text-secondary mb-2">📝 バージョン仕様・更新履歴</h5>
            <div class="card shadow-sm">
                <div class="card-body p-0">
                    <table class="table table-bordered table-striped mb-0 align-middle">
                        <thead class="table-dark">
                            <tr>
                                <th style="width: 30%;" class="ps-3">項目・カテゴリ</th>
                                <th>内容・変更点（可変明細）</th>
                            </tr>
                        </thead>
                        <tbody id="detailTableBody">
                            <tr>
                                <td colspan="2" class="text-center text-muted p-3">データを読み込み中...</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- 管理者専用フォーム -->
    @if (ViewBag.IsAdminMode == true)
    {
        <div class="mt-5 p-4 border border-danger bg-danger bg-opacity-10 rounded shadow-sm">
            <h5 class="fw-bold text-danger mb-3">📸 【管理者限定】このバージョンの画面スクショを取り込む</h5>
            <form asp-action="UploadImage" method="post" enctype="multipart/form-data" class="row g-3 align-items-center">
                <input type="hidden" name="productId" value="@productId" />
                <input type="hidden" name="versionNo" id="hiddenVersionNo" value="1" />
                <input type="hidden" name="urlSecret" value="@Context.Request.Query["secret"]" />

                <div class="col-md-8">
                    <input class="form-control form-control-lg border-danger" type="file" id="imageFile" name="imageFile" accept="image/jpeg, image/png" required>
                </div>
                <div class="col-md-4">
                    <button type="submit" class="btn btn-danger btn-lg w-100 fw-bold shadow" onclick="syncVersionBeforeUpload()">
                        💾 ポスグレにスクショを保存
                    </button>
                </div>
            </form>
        </div>
    }
</div>

