        //         // 画像がない場合は、画面いっぱいに広げます
        //         detailArea.className = "col-12";
        //     }
        // }

        function toggleImageArea(hasImage) {
            const imgTag = document.getElementById("productImage");
            const imageArea = document.getElementById("imageArea");
            const detailArea = document.getElementById("detailArea");

            if (imgTag && imgTag.src.startsWith("data:image")) return;

            if (hasImage) {
                imageArea.style.display = "block";
                // 💡【修正】「-md-」を抜くことで、スマホの画面幅でも絶対に2カラム（横並び）を強制します！
                imageArea.className = "col-5 text-center";
                detailArea.className = "col-7";
            } else {
                imageArea.style.display = "none";
                detailArea.className = "col-12";
            }
        }


        function syncVersionBeforeUpload() {
            const currentVer = document.getElementById("versionDropdown").value;
            document.getElementById("hiddenVersionNo").value = currentVer;
        }

        function escapeHtml(str) {
            if (!str) return "";
            return str.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;").replace(/'/g, "&#039;");
        }
    </script>
